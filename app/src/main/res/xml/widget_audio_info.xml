<?xml version="1.0" encoding="utf-8"?>
<!-- Audiobook transport (A03c). The service pushes the state; the widget never starts playback by itself. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_audio_description"
    android:initialLayout="@layout/widget_audio"
    android:minWidth="220dp"
    android:minHeight="64dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="64dp"
    android:previewLayout="@layout/widget_audio"
    android:resizeMode="horizontal"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
