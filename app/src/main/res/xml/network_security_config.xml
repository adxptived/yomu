<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is allowed because user-added OPDS servers (Calibre, Kavita, Komga…) often run over plain HTTP in a home network.
     Built-in sources use HTTPS only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
