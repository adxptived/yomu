<?xml version="1.0" encoding="utf-8"?>
<!-- Declarations required by WorkManager workers in this module; merged into the app manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application>
        <!-- Downloads, library updates and book translation run as dataSync foreground work. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Buttons of the download notifications (explicit, immutable intents of this app only). -->
        <receiver
            android:name="app.yomu.data.work.DownloadActionReceiver"
            android:exported="false" />
    </application>

</manifest>
